bun src/cli.ts doctor | jq -c '.checks[] | {name, ok}'
clear; jq -c '.source, .steps[]' scenarios/browser-wikipedia.json
clear; bun src/cli.ts check scenarios/browser-wikipedia.json --allow-origin https://en.wikipedia.org | jq -c
clear; bun src/cli.ts run scenarios/browser-wikipedia.json --allow-origin https://en.wikipedia.org --force 2>/dev/null | jq '{ok, stage, outputPath, zooms, annotations} | .outputPath |= sub(".*/out/"; "out/")'
clear; bun src/cli.ts run scenarios/desktop-calculator.json --allow-app com.apple.calculator --force 2>/dev/null | jq '{ok, stage, outputPath, zooms, annotations} | .outputPath |= sub(".*/out/"; "out/")'
clear; bun src/cli.ts run scenarios/file-reedit.json --force 2>/dev/null | jq -c '{ok, outputPath, annotations} | .outputPath |= sub(".*/out/"; "out/")'
