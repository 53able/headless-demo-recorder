{
  "name": "wikipedia-search",
  "source": {
    "type": "browser",
    "url": "https://en.wikipedia.org/wiki/Main_Page",
    "viewport": [
      1280,
      800
    ]
  },
  "steps": [
    {
      "action": "mark",
      "caption": "画面録画について調べる",
      "waitMs": 1200
    },
    {
      "action": "fill",
      "target": "#searchInput",
      "value": "Screen recording",
      "caption": "知りたい語で検索する",
      "waitMs": 1200
    },
    {
      "action": "press",
      "key": "Enter",
      "caption": "検索結果を開く",
      "waitMs": 2500
    },
    {
      "action": "scroll",
      "direction": "down",
      "px": 600,
      "caption": "用途の説明まで読み進める",
      "waitMs": 1500
    }
  ],
  "edit": {
    "zoom": {
      "depth": 3,
      "leadMs": 500,
      "holdMs": 1800
    },
    "titles": [
      {
        "text": "headless-demo-recorder demo",
        "startMs": 0,
        "endMs": 1200
      }
    ]
  },
  "output": {
    "path": "out/wikipedia-search.mp4",
    "quality": "good"
  }
}
